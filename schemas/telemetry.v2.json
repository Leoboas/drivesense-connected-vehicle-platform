{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriveSense telemetry event v2",
  "type": "object",
  "required": ["schema_version", "event_id", "vehicle_id", "trip_id", "timestamp", "latitude", "longitude", "speed_kph", "battery_soc", "network_type", "signal_dbm", "latency_ms", "connection_state"],
  "properties": {
    "schema_version": {"const": "telemetry.v2", "description": "Backward-compatible additive contract version"},
    "event_id": {"type": "string", "minLength": 1}, "vehicle_id": {"type": "string", "minLength": 1}, "trip_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"}, "latitude": {"type": "number"}, "longitude": {"type": "number"},
    "speed_kph": {"type": "number"}, "battery_soc": {"type": "number"},
    "network_type": {"enum": ["5G", "LTE", "3G", "OFFLINE"]}, "signal_dbm": {"type": "number"}, "latency_ms": {"type": "number"},
    "connection_state": {"enum": ["CONNECTED", "DEGRADED", "OFFLINE", "RECOVERY"]},
    "battery_temperature_c": {"type": ["number", "null"], "description": "Optional battery temperature"},
    "sensor_firmware_version": {"type": ["string", "null"]}, "network_provider": {"type": ["string", "null"]},
    "gps_accuracy_m": {"type": ["number", "null"]},
    "scenario": {"type": "string"}, "route_id": {"type": "string"},
    "route_segment": {"type": "string"}, "region_type": {"enum": ["URBAN", "HIGHWAY", "TRAIL"]},
    "offline_duration_s": {"type": "integer", "minimum": 0},
    "reconnection_count": {"type": "integer", "minimum": 0},
    "sync_duration_ms": {"type": "integer", "minimum": 0}
    ,"packet_loss_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "network_provider": {"type": "string"}, "bytes_buffered": {"type": "integer", "minimum": 0},
    "road_class": {"type": "string"}, "distance_remaining_km": {"type": "number", "minimum": 0},
    "eta_minutes": {"type": "number", "minimum": 0}, "reroute_count": {"type": "integer", "minimum": 0},
    "map_match_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "screen_id": {"type": "string"}, "interaction_type": {"type": "string"},
    "warning_level": {"type": "string"}, "driver_action": {"type": "string"},
    "driver_response_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "energy_consumption_kwh": {"type": "number", "minimum": 0}, "range_estimate_km": {"type": "number", "minimum": 0},
    "tire_pressure_status": {"type": "string"}, "vehicle_state": {"type": "string"},
    "ingested_at": {"type": "string", "format": "date-time"}, "late_arrival_seconds": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0}, "processing_latency_ms": {"type": "integer", "minimum": 0},
    "weather_condition": {"type": "string"}, "road_surface": {"type": "string"},
    "traffic_level": {"type": "string"}, "visibility_level": {"type": "string"}
  },
  "additionalProperties": true
}
